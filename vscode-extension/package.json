{
  "name": "sysml-v2-viewer",
  "displayName": "SysML v2 Viewer",
  "description": "%desc%",
  "version": "0.3.0",
  "publisher": "ib-wb",
  "author": {
    "name": "Wolfgang Becker"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "SysML",
    "SysML v2",
    "MBSE",
    "Traceability",
    "Requirements"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onWebviewPanel:sysmlViewer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sysmlViewer.open",
        "title": "%cmd.open%",
        "category": "SysML",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "sysmlViewer.reveal",
        "title": "%cmd.reveal%",
        "category": "SysML",
        "icon": "$(target)"
      },
      {
        "command": "sysmlViewer.refresh",
        "title": "%cmd.refresh%",
        "category": "SysML"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sysmlViewer.open",
          "when": "resourceExtname == .sysml || resourceExtname == .kerml",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "sysmlViewer.reveal",
          "when": "resourceExtname == .sysml || resourceExtname == .kerml",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "sysmlViewer.open",
          "when": "explorerResourceIsFolder || resourceExtname == .sysml",
          "group": "navigation@90"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sysmlViewer.reveal",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && (resourceExtname == .sysml || resourceExtname == .kerml)"
      }
    ],
    "configuration": {
      "title": "SysML v2 Viewer",
      "properties": {
        "sysmlViewer.followNavigator": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.followNavigator%"
        },
        "sysmlViewer.include": {
          "type": "string",
          "default": "**/*.{sysml,kerml}",
          "description": "%cfg.include%"
        },
        "sysmlViewer.exclude": {
          "type": "string",
          "default": "**/{node_modules,.git,build,dist,out}/**",
          "description": "%cfg.exclude%"
        },
        "sysmlViewer.liveUpdate": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.liveUpdate%"
        }
      }
    }
  }
}
